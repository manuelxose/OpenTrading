# OpenTrading core runtime settings (Phase 0 Foundations).
# Copy to `.env` for local development. Never commit `.env` (see .gitignore).
#
# PRODUCTION: secrets live only in `secrets/*.env` encrypted with SOPS + age.
# See docs/runbooks/secrets-management.md. Dev values below are placeholders,
# not secrets.

# Operating mode. Only these five exist (INV-8).
# RESEARCH | BACKTEST | PAPER | LIVE_GATED | LIVE_AUTO
# LLM processes (apps.worker) refuse to start in LIVE_* modes (ADR-0025).
OT_OPERATING_MODE=RESEARCH

OT_ENVIRONMENT=development
OT_LOG_LEVEL=INFO
OT_AUDIT_ENABLED=true
OT_API_HOST=127.0.0.1
OT_API_PORT=8000

# ── Application readiness checks (GET /readyz) ──────────────────────────────
# Point at the local docker-compose services (see docs/runbooks/local-development.md).
OT_POSTGRES_DSN=postgresql://opentrading:opentrading-dev@127.0.0.1:5432/opentrading
# Production: set OT_POSTGRES_DSN to the DML-only `ot_app` role and run
# migrations as `ot_migrator` via this DSN (ADR-0025 least privilege).
# OT_POSTGRES_MIGRATOR_DSN=postgresql://ot_migrator:<password>@127.0.0.1:5432/opentrading
# Production Redis uses ACL users (no `default`):
# OT_REDIS_URL=redis://opentrading:<password>@127.0.0.1:6379/0
OT_REDIS_URL=redis://:opentrading-dev@127.0.0.1:6379/0
# FalkorDB requires a password (ADR-0025).
OT_FALKORDB_URL=redis://:falkordb-dev@127.0.0.1:6380/0
OT_MINIO_ENDPOINT=127.0.0.1:9000
# Production: scoped `platform` user (per-bucket policy), never root credentials.
OT_MINIO_ACCESS_KEY=opentrading
OT_MINIO_SECRET_KEY=opentrading-dev
OT_MINIO_READINESS_BUCKET=raw
OT_READINESS_TIMEOUT_SECONDS=2.0

# Market data platform (Phase 1): silver STALE flag threshold in seconds.
OT_MARKET_DATA_STALE_AFTER_SECONDS=3600.0

# ── Autonomous PAPER pipeline (Phase 7, apps/worker) ────────────────────────
# Run: uv run python -m apps.worker run --store postgres --bus redis --llm mock
OT_PAPER_MODE_ENABLED=false
OT_PAPER_INSTRUMENTS=EURUSD
OT_PAPER_CYCLE_INTERVAL_SECONDS=300
OT_PAPER_LLM_ENABLED=true
OT_PAPER_LLM_REQUIRED=false       # false: a failed LLM never blocks the cycle
OT_PAPER_LLM_TIMEOUT_SECONDS=300.0
OT_PAPER_STARTING_BALANCE=100000
OT_PAPER_POSITION_EQUITY_PCT=0.02
OT_PAPER_SLIPPAGE_TICKS=1
OT_PAPER_COMMISSION_BPS=0.5
OT_PAPER_STOP_ATR_RATIO=1.5
OT_PAPER_TAKE_ATR_RATIO=3
OT_PAPER_REDIS_STREAM=opentrading:events
OT_PAPER_CONSUMER_GROUP_PREFIX=opentrading-workers
OT_PAPER_CONSUMER_NAME=worker-1
OT_PAPER_MAX_DELIVERIES=5
OT_PAPER_BLOCK_MS=2000
OT_PAPER_BATCH_SIZE=10

# ── Post-trade analysis & learning engine (Phase 7, engines/posttrade) ───────
# Sinks: PostgreSQL (always), MinIO artifacts, Graphiti lesson, Obsidian note.
OT_POSTTRADE_VAULT_PATH=vault-trading
OT_POSTTRADE_ARTIFACT_BUCKET=posttrade-artifacts

# ── Local infrastructure (infra/compose/docker-compose.yml) ─────────────────
# Dev-only placeholders. Production never uses these: the prod compose override
# requires every secret and fails closed if one is missing (see
# docs/runbooks/infrastructure.md). Generate real values for .env.prod with
# `openssl rand -hex 32`.

# Host port overrides (change these if anything already listens locally;
# update the matching OT_*_DSN/URL settings above to follow).
OT_POSTGRES_HOST_PORT=5432
OT_REDIS_HOST_PORT=6379
OT_MINIO_HOST_PORT=9000
OT_MINIO_CONSOLE_HOST_PORT=9001
OT_FALKORDB_HOST_PORT=6380
OT_CLICKHOUSE_HOST_PORT=8123
OT_LANGFUSE_HOST_PORT=3000
OT_MLFLOW_HOST_PORT=5000
OT_PROMETHEUS_HOST_PORT=9090
OT_GRAFANA_HOST_PORT=3001

POSTGRES_DB=opentrading
POSTGRES_USER=opentrading
POSTGRES_PASSWORD=opentrading-dev

# ── Least-privilege Postgres roles (ADR-0025, infra/postgres/init/002-roles.sh)
# ot_migrator = DDL/Alembic, ot_app = DML, ot_readonly = SELECT (Grafana/exporters)
POSTGRES_MIGRATOR_PASSWORD=opentrading-dev
POSTGRES_APP_PASSWORD=opentrading-dev
POSTGRES_READONLY_PASSWORD=opentrading-dev
# Sidecar databases: Langfuse and MLflow own only their own database
LANGFUSE_DB_PASSWORD=opentrading-dev
MLFLOW_DB_PASSWORD=opentrading-dev

REDIS_PASSWORD=opentrading-dev
# redis-exporter ACL user (production; read-only command set)
REDIS_EXPORTER_PASSWORD=opentrading-dev

FALKORDB_PASSWORD=falkordb-dev

MINIO_ROOT_USER=opentrading
MINIO_ROOT_PASSWORD=opentrading-dev
# Scoped MinIO users with per-bucket policies (ADR-0025; production only).
# Leave empty in dev to keep using root credentials.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
MINIO_LANGFUSE_ACCESS_KEY=
MINIO_LANGFUSE_SECRET_KEY=
MINIO_MLFLOW_ACCESS_KEY=
MINIO_MLFLOW_SECRET_KEY=

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse-dev

# Langfuse (LLM observability) — dev-only values.
# NEVER put secrets, credentials or broker material into Langfuse prompts,
# trace inputs or metadata (§29 / ADR-0025).
LANGFUSE_NEXTAUTH_URL=http://127.0.0.1:3000
LANGFUSE_NEXTAUTH_SECRET=opentrading-dev-auth-secret
LANGFUSE_SALT=opentrading-dev-salt
# 32 bytes hex: `openssl rand -hex 32`
LANGFUSE_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
LANGFUSE_INIT_PUBLIC_KEY=pk-lf-opentrading-dev
LANGFUSE_INIT_SECRET_KEY=sk-lf-opentrading-dev
LANGFUSE_INIT_EMAIL=admin@opentrading.local
LANGFUSE_INIT_PASSWORD=opentrading-dev
# Core-runtime SDK credentials (use a scoped project key in production).
LANGFUSE_PUBLIC_KEY=pk-lf-opentrading-dev
LANGFUSE_SECRET_KEY=sk-lf-opentrading-dev
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_TRACING_ENVIRONMENT=development

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-dev

# ── MT4 execution protocol (Phase 6, ADR-0020) ───────────────────────────────
# Private ZeroMQ channels; never internet-exposed. When MT4 runs on a remote
# Windows host, point these at the WireGuard tunnel interface.
OT_MT4_COMMAND_ADDR=tcp://127.0.0.1:5555
OT_MT4_EVENTS_ADDR=tcp://127.0.0.1:5556
OT_MT4_QUOTES_ADDR=tcp://127.0.0.1:5557
OT_MT4_PROTOCOL_VERSION=1.0
OT_MT4_HEARTBEAT_INTERVAL_SECONDS=1.0
OT_MT4_DEGRADED_AFTER_SECONDS=3.0
OT_MT4_DOWN_AFTER_SECONDS=6.0
OT_MT4_REQUEST_TIMEOUT_SECONDS=5.0

# ── LIVE_AUTO (Phase 11) — disabled by default ───────────────────────────────
# Only strategies in the LIVE_AUTO lifecycle state (promoted from LIVE_GATED by
# an authenticated operator action with an immutable audit event) may trade
# without per-trade human approval. Every automated order still passes the
# deterministic Risk Engine, the emergency/kill-switch controls and the MT4
# local safety checks.
OT_LIVE_AUTO_ENABLED=false
OT_LIVE_AUTO_MAX_STRATEGIES=0
# OT_LIVE_AUTO_MAX_CAPITAL=0        # account-currency ceiling, required to enable
# OT_LIVE_AUTO_MAX_LOSS=0           # global realized-loss limit, required to enable
# Per-strategy risk-budget ceilings (JSON): {"strategy-a": 500}
# OT_LIVE_AUTO_STRATEGY_RISK_BUDGETS={}

# ── Emergency control system (INV-7, architecture §10) ───────────────────────
# Dead man switch over the Core ↔ MT4 heartbeat: loss blocks new entries, keeps
# broker-side SL/TP untouched and raises a CRITICAL alert. Flattening is an
# explicit opt-in — connectivity loss never auto-closes positions.
OT_EMERGENCY_DEAD_MAN_ENABLED=true
OT_EMERGENCY_HEARTBEAT_TIMEOUT_SECONDS=6.0
OT_EMERGENCY_CANCEL_PENDING_ON_KILL=true
OT_EMERGENCY_FLATTEN_ON_KILL=false
OT_EMERGENCY_FLATTEN_ON_HEARTBEAT_LOSS=false
